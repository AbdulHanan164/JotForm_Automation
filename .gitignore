# Environment & secrets
.env
.env.*
!.env.example

# JotForm API response cache (regenerated at runtime)
config/forms/

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
dist/
build/

# Virtual environments
.venv/
venv/

# Data — contains client PII, never commit ANY of it.
# All directories are auto-created at startup (app/config.py).
data/

# Logs
logs/

# Node (one-off docx generation scripts only — not part of the service)
node_modules/
package.json
package-lock.json

# Office temp files
~$*

# Test outputs
test_results/

# IDE
.idea/
.vscode/
*.swp
