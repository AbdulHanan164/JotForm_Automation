# ═══════════════════════════════════════════════════════════════════════════
# מה זה קל — JotForm Webhook — environment variables
# Copy to .env for local development. NEVER commit .env.
# On Render these are set in the dashboard (see render.yaml / DEPLOYMENT.md).
# ═══════════════════════════════════════════════════════════════════════════

# ── Security (REQUIRED in production) ────────────────────────────────────────
# Generate each: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Empty value = check DISABLED (dev/test only).
OPERATOR_API_KEY=
WEBHOOK_SECRET=

# ── JotForm API (optional — enables form-definition sync at startup) ─────────
# Get from: https://www.jotform.com/myaccount/api
JOTFORM_API_KEY=

# ── Google Sheets (optional) ──────────────────────────────────────────────────
# Path to a service-account credentials JSON file.
# On Render: upload as a Secret File and use /etc/secrets/<filename>.
GOOGLE_SHEETS_CREDENTIALS_PATH=

# ── Data directories (optional — default to ./data/* and ./logs) ─────────────
# On Render these point at the persistent disk (set via render.yaml).
#SUBMISSIONS_DIR=data/submissions
#PROCESSED_DIR=data/processed
#REVIEW_DIR=data/review_queue
#DOCUMENTS_DIR=data/documents
#LOGS_DIR=logs

# ── Unused in current version (reserved) ─────────────────────────────────────
#OPENAI_API_KEY=
#NVIDIA_API_KEY=
#HUBSPOT_API_KEY=
#GOOGLE_DRIVE_CREDENTIALS_PATH=
